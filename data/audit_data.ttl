:Account a owl:Class ;
    rdfs:label "Account" ;
    rdfs:comment "An accounting account for recording transactions" .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "An entity that purchases goods or services" .

:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A good or service offered for sale" .

:Delivery a owl:Class ;
    rdfs:label "Delivery" ;
    rdfs:comment "The physical delivery of goods to a customer" .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A bill sent to a customer for goods or services" .

:JournalEntry a owl:Class ;
    rdfs:label "Journal Entry" ;
    rdfs:comment "An accounting entry recording financial transactions" .

:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A customer order for products or services" .

